# VERONICA — environment variables
#
# Every one of these is optional -- a missing value simply disables the
# one connector/feature that needs it (logged by variable name, never
# by value). See docs/DEPLOYMENT.md and docs/VOICE_SETUP.md for the
# full breakdown of what each one unlocks.

# Primary AI provider -- required for any real reasoning/agent call.
ANTHROPIC_API_KEY=

# Embeddings fallback for semantic memory search (keyword search still
# works without it).
OPENAI_API_KEY=

# Gates every mutating dashboard route. Unset = dashboard is read-only.
API_TOKEN=

# Dashboard bind address/port.
DASHBOARD_PORT=4000
DASHBOARD_HOST=127.0.0.1

# NODE_ENV-style environment label, shown in Mission Control's status bar.
NODE_ENV=development

# Connectors (each independently optional).
GITHUB_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Comma-separated hostnames allowlisted for core/integrations/http.js's
# outbound requests.
SERVICE_ALLOWLIST=

# Voice layer (see docs/VOICE_SETUP.md) -- off by default.
VOICE_ENABLED=false
WHISPER_PATH=
WHISPER_MODEL=
PIPER_PATH=
PIPER_MODEL=
VOICE_WAKE_WORD_COMMAND=
VOICE_WAKE_WORD_ARGS=
WAKEWORD_MODEL=
