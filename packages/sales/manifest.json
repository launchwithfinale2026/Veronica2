{
    "name": "sales",
    "description": "Sales department -- pipeline management and account review.",
    "version": "0.1.0",
    "agents": [
        {
            "name": "SalesAgent",
            "department": "sales-dept",
            "role": "Sales Representative",
            "capabilities": [
                "lead qualification",
                "outreach"
            ]
        },
        {
            "name": "AccountManager",
            "department": "sales-dept",
            "role": "Account Manager",
            "capabilities": [
                "account management",
                "renewals"
            ]
        },
        {
            "name": "PipelineAnalyst",
            "department": "sales-dept",
            "role": "Pipeline Analyst",
            "capabilities": [
                "pipeline analysis",
                "forecasting"
            ]
        }
    ],
    "tools": [
        {
            "id": "sales.pipeline.review",
            "description": "Real pipeline review via core/sales/analytics.js: win/loss history, deterministic weighted-pipeline forecast, and lead count for a company. No external API needed.",
            "permission": "read_memory",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "companyId": { "type": "string" }
                },
                "required": ["companyId"]
            }
        }
    ],
    "dependencies": [],
    "permissions": [
        "read"
    ],
    "department": {
        "id": "sales-dept",
        "name": "Sales",
        "domain": "Revenue"
    },
    "approvalRequired": true
}