        {
            "name": "OperationsManager",
            "department": "bizops",
            "role": "Operations Manager",
            "capabilities": [
                "workflow design",
                "process optimization"
            ]
        },
        {
            "name": "ProcessAnalyst",
            "department": "bizops",
            "role": "Process Analyst",
            "capabilities": [
                "process analysis",
                "efficiency review"
            ]
        }
