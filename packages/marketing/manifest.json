{
    "name": "marketing",
    "description": "Marketing department -- campaign management, content strategy, and analytics, matching core/capabilities/planner.js's \"marketing\" capability catalog entry.",
    "version": "0.1.0",
    "agents": [
        {
            "name": "MarketingDirector",
            "department": "marketing-dept",
            "role": "Marketing Director",
            "capabilities": [
                "marketing strategy",
                "prioritization"
            ]
        },
        {
            "name": "CampaignManager",
            "department": "marketing-dept",
            "role": "Campaign Manager",
            "capabilities": [
                "campaign management"
            ]
        },
        {
            "name": "ContentStrategist",
            "department": "marketing-dept",
            "role": "Content Strategist",
            "capabilities": [
                "content creation"
            ]
        },
        {
            "name": "BrandManager",
            "department": "marketing-dept",
            "role": "Brand Manager",
            "capabilities": [
                "brand voice",
                "brand guidelines"
            ]
        },
        {
            "name": "PublishingManager",
            "department": "marketing-dept",
            "role": "Publishing Manager",
            "capabilities": [
                "publishing",
                "approval routing"
            ]
        },
        {
            "name": "MarketingAnalyticsAgent",
            "department": "marketing-dept",
            "role": "Analytics Agent",
            "capabilities": [
                "audience research",
                "analytics"
            ]
        }
    ],
    "tools": [
        {
            "id": "marketing.campaign.plan",
            "description": "Create a real campaign for a company (objective/audience/platforms/timeline/assets) via core/marketing/campaigns.js. Real, working -- no external API needed to plan a campaign; publishing it later does go through the real, approval-gated Publishing Queue (core/executive/actionProposal.js's publish_content action).",
            "permission": "write_memory",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "companyId": { "type": "string" },
                    "name": { "type": "string" },
                    "objective": { "type": "string" },
                    "audience": { "type": "string" },
                    "platforms": { "type": "array", "items": { "type": "string" } },
                    "timeline": { "type": "object" },
                    "assets": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["companyId", "objective"]
            }
        }
    ],
    "dependencies": [],
    "permissions": [
        "external_api"
    ],
    "department": {
        "id": "marketing-dept",
        "name": "Marketing",
        "domain": "Growth"
    },
    "approvalRequired": true
}