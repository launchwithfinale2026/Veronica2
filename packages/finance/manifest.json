{
    "name": "finance",
    "description": "Finance department -- bookkeeping, forecasting, and compliance, matching core/capabilities/planner.js's \"finance\" capability catalog entry.",
    "version": "0.1.0",
    "agents": [
        {
            "name": "Bookkeeper",
            "department": "finance-dept",
            "role": "Bookkeeper",
            "capabilities": [
                "bookkeeping"
            ]
        },
        {
            "name": "FinancialAnalyst",
            "department": "finance-dept",
            "role": "Financial Analyst",
            "capabilities": [
                "forecasting"
            ]
        },
        {
            "name": "ComplianceOfficer",
            "department": "finance-dept",
            "role": "Compliance Officer",
            "capabilities": [
                "compliance"
            ]
        }
    ],
    "tools": [
        {
            "id": "finance.report.generate",
            "description": "Real financial report via core/finance/reports.js: KPIs (financial summary, MRR/ARR, accounts receivable, runway), historical cash flow, a deterministic forecast, and budget-vs-actual status. No banking connection needed.",
            "permission": "read_memory",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "companyId": { "type": "string" }
                },
                "required": ["companyId"]
            }
        }
    ],
    "dependencies": [],
    "permissions": [
        "financial_data"
    ],
    "department": {
        "id": "finance-dept",
        "name": "Finance",
        "domain": "Finance"
    },
    "approvalRequired": true
}